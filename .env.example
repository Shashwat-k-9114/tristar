# Copy to .env.local for local development. NEVER commit real values.

# --- Google Sheet backend: choose ONE of the two options ---

# Option A (recommended, free, no card): Apps Script web app bound to the sheet (see README)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
APPS_SCRIPT_SECRET=the-same-long-random-string-you-put-in-Code.gs

# Option B: Google Cloud service account (needs a Cloud project, which may ask for billing details)
# GOOGLE_SHEET_ID=17p2y4vGVd_vxAA6oij8oximj_TOAHN02cxbPAwLWW2g
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Staff dashboard (/admin) ---
ADMIN_PASSWORD=choose-a-long-password
SESSION_SECRET=generate-with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Local development only: store submissions in .data/store.json instead of Google Sheets
# LOCAL_STORE=1

# Optional first-run default for staff email recipients (comma-separated). Manage them later in /admin -> Settings.
# ADMIN_EMAILS=owner@example.com
